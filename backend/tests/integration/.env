# Integration test isolation.
# Loaded by tests/integration/conftest.py (load_env_vars) with setdefault, so a
# variable already exported in the shell (e.g. via `--env-file .vscode/.env`)
# wins over anything here. Keep the two POSTGRES_DB / S3_FILE_STORE_BUCKET_NAME
# lines below OUT of .vscode/.env, otherwise dev data is at risk.
#
# Integration tests wipe whatever database POSTGRES_DB points at
# (tests/integration/common_utils/reset.py drops the schema) and delete every
# file in the file-store bucket. Pointing them at the dev postgres database and
# onyx-file-store-bucket destroys local dev state on every test run.
POSTGRES_DB=onyx_test
S3_FILE_STORE_BUCKET_NAME=onyx-test-file-store-bucket
